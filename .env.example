# MongoDB Atlas connection string with the database name ("farmora") after .net/
# Use a database user password made of letters and numbers only.
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/farmora?retryWrites=true&w=majority"
JWT_SECRET="replace-with-a-long-random-string"
ADMIN_EMAIL="admin@farmora.test"
ADMIN_PASSWORD="choose-a-strong-password"
PORT=5050

APP_URL="http://localhost:5173"
# SMTP settings from your email provider (e.g. Gmail app password, Zoho, Brevo, Mailgun, SES)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
MAIL_FROM="Farmora <no-reply@farmora.com>"
ADMIN_NOTIFY_EMAIL="orders@farmora.com"
# browser path of the admin area; must match VITE_ADMIN_PATH in farmora-frontend/.env
ADMIN_PATH="/officerArea"

# Public address of the site, e.g. https://farmora.com. When set, image URLs in the API are absolute (needed by mobile apps).
PUBLIC_URL=""
