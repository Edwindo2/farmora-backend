// Farmora database schema (MongoDB, e.g. MongoDB Atlas).
// DATABASE_URL is a mongodb+srv:// connection string that includes the database name.
// After any change to this file run `npm run db:push` (MongoDB uses db push, never prisma migrate).
//
// Money is stored as integers in minor units (kobo for NGN, cents for USD) to avoid rounding errors.
// Status-like fields are plain strings; the allowed values are listed in comments and enforced in src/constants.js.
// IDs are cuid strings stored in MongoDB's _id field.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

/// A product line, e.g. "Special Red Palm Oil".
model Product {
  id           String           @id @default(cuid()) @map("_id")
  wishlistedBy WishlistItem[]
  slug         String           @unique
  name         String
  tag          String
  description  String
  image        String?
  active       Boolean          @default(true)
  sortOrder    Int              @default(0)
  variants     ProductVariant[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

/// A pack size of a product, e.g. "5 litres" or "20ft container", with its own prices and stock.
model ProductVariant {
  id             String      @id @default(cuid()) @map("_id")
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  code           String // short code used by the storefront, e.g. "5l", "drum"
  label          String
  sku            String      @unique
  priceNgn       Int? // kobo; null = price on request
  priceUsd       Int? // cents; null = price on request
  wholesaleNgn   Int? // kobo; price for approved wholesale accounts (null = use the normal price)
  wholesaleUsd   Int? // cents
  distributorNgn Int? // kobo; price for approved distributors (null = use the wholesale price)
  distributorUsd Int? // cents
  stock          Int? // units on hand; null = not tracked
  active         Boolean     @default(true)
  sortOrder      Int         @default(0)
  orderItems     OrderItem[]

  @@unique([productId, code])
}

/// A buyer. Created or updated by email whenever an order or message comes in.
model Customer {
  id                  String               @id @default(cuid()) @map("_id")
  email               String               @unique
  name                String
  phone               String?
  company             String?
  buyerType           String               @default("individual") // individual | business
  country             String?
  passwordHash        String? // set when the customer registers; null for guest-only customers
  pendingPasswordHash String? // chosen at registration, activated once the email is confirmed
  accountType         String               @default("individual") // individual | wholesale | distributor | international
  wholesaleStatus     String               @default("none") // none | pending | approved | rejected (wholesale and distributor approval)
  area                String? // distributors: the states / areas they cover
  monthlyVolume       String? // distributors: expected monthly volume, in their words
  wishlist            WishlistItem[]
  lastLoginAt         DateTime?
  orders              Order[]
  messages            ContactMessage[]
  loginTokens         CustomerLoginToken[]
  addresses           Address[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

/// A customer order.
model Order {
  id         String   @id @default(cuid()) @map("_id")
  reference  String   @unique // e.g. FM-7Q2K9D, shown to the customer
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  // delivery
  deliveryType   String // local | international
  country        String
  state          String? // Nigerian state for local delivery
  city           String
  address        String? // street address for local delivery
  port           String? // destination port/airport for export
  shippingMethod String? // air | fob | cif | advise

  // money (minor units of `currency`)
  currency    String // NGN | USD
  subtotal    Int? // null when any item is "price on request"
  deliveryFee Int? // set by admin when confirming
  total       Int?
  quoteNeeded Boolean @default(false)

  // workflow
  status         String    @default("received") // received | confirmed | paid | processing | shipped | delivered | cancelled
  paymentMethod  String?
  paymentStatus  String    @default("unpaid") // unpaid | paid | refunded
  trackingNumber String?
  neededBy       DateTime?
  notes          String? // from the customer
  adminNotes     String? // internal only

  items     OrderItem[]
  events    OrderStatusEvent[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// A line on an order. Name, label and price are copied at order time so later catalog edits don't change history.
model OrderItem {
  id           String          @id @default(cuid()) @map("_id")
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId      String
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId    String?
  productName  String
  variantLabel String
  quantity     Int
  unitPrice    Int? // minor units of the order currency; null = quote
  lineTotal    Int?
}

/// History of an order's status changes, shown on the tracking page and in admin.
model OrderStatusEvent {
  id        String   @id @default(cuid()) @map("_id")
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    String
  note      String? // visible to the customer when public = true
  public    Boolean  @default(true)
  createdBy String? // admin email, or "customer"
  createdAt DateTime @default(now())

  @@index([orderId])
}

/// A message sent through the Contact Us form.
model ContactMessage {
  id         String    @id @default(cuid()) @map("_id")
  reference  String    @unique
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?
  name       String
  email      String
  phone      String?
  topic      String
  message    String
  status     String    @default("new") // new | read | replied | archived
  createdAt  DateTime  @default(now())
}

/// A person who can sign in to the admin dashboard.
model AdminUser {
  id           String               @id @default(cuid()) @map("_id")
  email        String               @unique
  name         String
  passwordHash String
  role         String               @default("admin") // admin | staff
  lastLoginAt  DateTime?
  createdAt    DateTime             @default(now())
  resetTokens  PasswordResetToken[]
}

/// One-time link for resetting an admin password. Only a hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid()) @map("_id")
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

/// One-time sign-in link for the customer "My orders" area (no passwords). Only a hash is stored.
model CustomerLoginToken {
  id         String    @id @default(cuid()) @map("_id")
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId])
}

/// A question on the public FAQ, grouped by category. Edited in the admin.
model FaqItem {
  id        String   @id @default(cuid()) @map("_id")
  category  String
  question  String
  answer    String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Site-wide settings edited in the admin, e.g. key "site" holds contact and location details as JSON.
model Setting {
  key       String   @id @map("_id")
  value     String
  updatedAt DateTime @updatedAt
}

/// A real customer review shown on the home page. Added by the admin.
model Review {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  place     String?
  quote     String
  rating    Int      @default(5)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// A news item for the "Latest updates" card on the home page.
model NewsPost {
  id        String   @id @default(cuid()) @map("_id")
  title     String
  summary   String
  image     String?
  link      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// An email address from the footer newsletter form.
model NewsletterSubscriber {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  createdAt DateTime @default(now())
}

/// A saved delivery address in the customer's account, offered at checkout.
model Address {
  id           String   @id @default(cuid()) @map("_id")
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId   String
  label        String   @default("Home") // e.g. Home, Shop, Warehouse
  deliveryType String // local | international
  fullName     String
  phone        String
  country      String
  state        String?
  city         String
  address      String? // street address (local)
  port         String? // destination port/airport (international)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([customerId])
}

/// A product a customer saved to their wishlist.
model WishlistItem {
  id         String   @id @default(cuid()) @map("_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}
